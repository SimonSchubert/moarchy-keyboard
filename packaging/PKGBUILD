# Build with:  cd packaging && makepkg -f
#
# Builds from the working tree above this file rather than fetching a tarball,
# so an uncommitted change can be packaged and installed on the phone without
# a release. Swap source=() for a git+https line once this has a repo.

pkgname=moarchy-keyboard
pkgver=0.1.0
# 5, for §4.10 -- the restore handle drags along the right edge and keeps its
# place, and its corners follow moarchy's ui.toml (ACs 54-60).
#
# 4 was AC 50 -- text focus no longer raises the keyboard. It comes up when
# the handle is tapped or when something drives SetVisible, and nothing else
# writes the bool, so a dismissal holds until a person ends it. AC 53 went with
# the edge it delayed.
#
# 3 was AC 53 itself, the retract delay; 2 was AC 52, the handle moving to
# Overlay while retracted so moarchy's overlays stop drawing over the one
# control that brings the keyboard back.
#
# The bump is the point rather than bookkeeping. moarchy pins this repo by
# commit, so its manifest can name the fix without the package version moving
# -- and a phone already holding 0.1.0-3 compares versions, not contents, and
# would never be offered it. An image would have hidden that completely,
# because it installs fresh.
pkgrel=5
pkgdesc="Themed on-screen keyboard for mobileomarchy (Qt6/QML, input-method-v2)"
arch=('aarch64')
url="https://github.com/SimonSchubert/moarchy-keyboard"
license=('MIT')

depends=(
  'qt6-base'
  'qt6-declarative'
  'qt6-wayland'
  'layer-shell-qt'
  'wayland'
  'libxkbcommon'
)
# wayland-scanner ships in the `wayland` package. wlr-protocols is deliberately
# NOT a dependency: it does not contain input-method-unstable-v2 or
# virtual-keyboard-unstable-v1 (only the wlr-* protocols), and no Arch package
# does, so both XML files are vendored in protocols/.
makedepends=('cmake' 'ninja' 'pkgconf')

# squeekboard and this cannot both run: zwp_input_method_manager_v2 grants one
# input method per seat, and the loser exits. Declaring the conflict makes that
# a pacman error at install time instead of a keyboard that silently never
# appears -- which is the exact failure mode this project exists to stop
# repeating.
conflicts=('squeekboard')

source=()
sha256sums=()

build() {
  cd "$startdir/.."
  cmake -S . -B build-pkg -G Ninja \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_INSTALL_PREFIX=/usr
  cmake --build build-pkg
}

package() {
  cd "$startdir/.."
  DESTDIR="$pkgdir" cmake --install build-pkg
}
